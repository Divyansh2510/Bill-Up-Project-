# Copy this file to .env and fill in real values. Never commit .env.

# Random string that signs login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# PostgreSQL connection: postgresql://USER:PASSWORD@HOST/DATABASE
DATABASE_URL=postgresql://postgres:your-db-password@localhost/Bill Up

# Gmail account used to send payment reminders (use a Gmail App Password)
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Admin dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# true while developing locally, false on the live server
FLASK_DEBUG=false

# --- Live server only ---
# true once the site is served over HTTPS (login cookie is then sent only over HTTPS)
SESSION_COOKIE_SECURE=false
# true when the app runs behind the hosting provider's proxy (Render, Railway, Nginx...)
TRUST_PROXY=false
# Address and port Waitress listens on when FLASK_DEBUG=false (most hosts set PORT for you)
HOST=0.0.0.0
PORT=5000
